name: Review
on: [pull_request]
jobs:
  build:
    runs-on: xcode-27
    steps:
      - uses: actions/checkout@v5
      - name: Select Xcode version
        run: sudo xcode-select -s '/Applications/Xcode_27.app'
      - name: bundle install
        env:
          DANGER_GITHUB_API_TOKEN: ${{ secrets.GITHUB_TOKEN }}
        run: |
          bundle install
          bundle exec fastlane review
